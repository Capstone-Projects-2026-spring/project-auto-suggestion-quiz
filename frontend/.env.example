# .env.example — copy to .env and fill in your values

# URL of the running backend API
# Defaults to http://localhost:8000 if not set
REACT_APP_API_URL=http://localhost:8000

# Supabase credentials — only required for OTP email login
# If you don't need OTP login, leave these blank and use the dev bypass instead
# (type "dev" as the email on the login page, requires DEBUG=True in backend/.env)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
